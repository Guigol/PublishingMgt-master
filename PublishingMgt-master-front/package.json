{
  "name": "publishfrontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",

  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },

  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },

  "dependencies": {
    "@angular/cdk": "^21.1.5",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",

    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2",

    "chart.js": "^4.5.1",
    "ng2-charts": "^10.0.0",
    "file-saver": "^2.0.5",
    "xlsx": "^0.18.5"
  },

  "devDependencies": {
    "@angular/cli": "^21.1.5",
    "@angular-devkit/build-angular": "^21.2.14",
    "@angular/compiler-cli": "^21.1.0",

    "@angular/material": "^21.1.5",

    "typescript": "~5.9.2",

    "cypress": "^15.17.0",

    "jasmine-core": "^6.3.0",
    "@types/jasmine": "^6.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",

    "@types/node": "^25.9.2",
    "@types/file-saver": "^2.0.7",

    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "@tailwindcss/postcss": "^4.1.12"
  }
}